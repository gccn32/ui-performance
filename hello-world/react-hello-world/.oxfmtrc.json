{
  "printWidth": 100, // Oxfmt default is 100 (Prettier uses 80)
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "ignorePatterns": ["dist/**", "*.min.js"] // Exclude files from formatting
}
